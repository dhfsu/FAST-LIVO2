<launch>
  <!-- Launch file for the SubT MRS Hawkins Long Corridor dataset. -->

  <arg name="rviz" default="true" />

  <rosparam command="load" file="$(find fast_livo)/config/SubT_MRS_Hawkins_Long_Corridor.yaml" />

  <node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
    <rosparam file="$(find fast_livo)/config/camera_SubT_MRS_Hawkins.yaml" />
  </node>

  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
  </group>
</launch>
